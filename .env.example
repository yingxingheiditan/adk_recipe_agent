# =====================================================================
# Global Environment Variables Example
# Copy this file to .env in each service directory or configure as needed.
# NEVER commit your real .env file or credentials to source control.
# =====================================================================

# Google Cloud & Vertex AI Configuration
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# Service URLs (for local development or deployed Cloud Run)
# 1. Main Chatbot (Default port: 8000)
MAIN_CHATBOT_PORT=8000

# 2. Recipe & Grocery Specialist Agent (Default port: 8002)
RECIPE_AGENT_PORT=8002
RECIPE_AGENT_URL=http://localhost:8002

# 3. FreshMarket Grocery Database API (Default port: 8001)
GROCERY_DB_PORT=8001
GROCERY_DB_SERVICE_URL=http://localhost:8001
GROCERY_DB_PATH=groceries.db
